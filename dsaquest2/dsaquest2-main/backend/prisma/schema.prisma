// Prisma schema — standard Prisma ORM setup (https://www.prisma.io)
// Reused pattern: User + relational progress tracking, common in
// open-source "prisma-express-jwt" boilerplates.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  avatar       String         @default("🦸")
  xp           Int            @default(0)
  level        Int            @default(1)
  createdAt    DateTime       @default(now())
  progress     TopicProgress[]
  quizAttempts QuizAttempt[]
}

model Topic {
  id          String          @id @default(uuid())
  slug        String          @unique // "arrays" | "stack" | "queue"
  title       String
  description String
  icon        String
  order       Int
  progress    TopicProgress[]
  quizzes     Quiz[]
}

model TopicProgress {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  topic        Topic    @relation(fields: [topicId], references: [id])
  topicId      String
  visualizerDone Boolean @default(false)
  quizBestScore  Int     @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([userId, topicId])
}

model Quiz {
  id        String        @id @default(uuid())
  topic     Topic         @relation(fields: [topicId], references: [id])
  topicId   String
  question  String
  options   String[]
  answerIdx Int
  attempts  QuizAttempt[]
}

model QuizAttempt {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  quizId    String
  correct   Boolean
  createdAt DateTime @default(now())
}
